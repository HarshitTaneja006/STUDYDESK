# Copy to .env for local development:
#   Copy-Item .env.example .env   (Windows)
#   cp .env.example .env          (macOS/Linux)

# --- Hosted Turso database (preferred) ---
# Get these from Turso:
#   turso db show <your-db-name> --url          -> TURSO_DATABASE_URL
#   turso db tokens create <your-db-name>       -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=libsql://studydesk-harshittaneja006.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9...

# --- Local fallback (offline dev, no Turso needed) ---
# The Prisma schema defaults to file:./prisma/dev.db when TURSO_* vars are absent,
# so nothing else is required for local development.
